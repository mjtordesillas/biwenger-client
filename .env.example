# Copy to .env for local use (gitignored, never commit real values).
# Same names are used as GitHub Actions secrets in CI.

# Biwenger login used server-side to fetch the squad.
BIWENGER_EMAIL=
BIWENGER_PASSWORD=

# AWS credentials used by `serverless deploy`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Serverless Framework v4 access key (non-interactive auth for CI/local deploy).
SERVERLESS_ACCESS_KEY=

# Value of the API Gateway native API key that gates /squad (any string
# works — AWS stores it verbatim). The native app sends it as x-api-key.
BIWENGER_CLIENT_MOBILE_API_KEY=
